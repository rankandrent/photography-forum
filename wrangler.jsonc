{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site: `npm run build` writes plain HTML to ./out, and wrangler uploads it as static assets.
  // No server runtime / OpenNext adapter is needed.
  "name": "uiuxdesignservices-us",
  "compatibility_date": "2026-09-26",
  // Custom domains: wrangler attaches these (DNS + SSL) on every deploy.
  // www → apex redirect is a Cloudflare Redirect Rule on the zone (see README).
  "routes": [
    { "pattern": "uiuxdesignservices.us", "custom_domain": true },
    { "pattern": "www.uiuxdesignservices.us", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
