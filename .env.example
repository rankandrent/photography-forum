# ---------------------------------------------------------------- database --
# Local:  docker run -d -e POSTGRES_PASSWORD=forum -e POSTGRES_USER=forum \
#           -e POSTGRES_DB=photoforum -p 5432:5432 postgres:16
# Hosted: Neon (neon.tech) and Supabase both have a free tier that fits this app.
DATABASE_URL="postgresql://forum:forum@127.0.0.1:5432/photoforum?schema=public"

# -------------------------------------------------------------------- auth --
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# Optional — leave blank and the "Continue with Google" button is hidden.
# Console: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ------------------------------------------------------------------- site ---
# Set this once you have a domain. Canonical URLs, sitemap.xml, RSS and Open
# Graph tags are all built from it. On Vercel it falls back to the deploy URL.
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------- uploads ---
# "local" writes to public/uploads — development only. Serverless hosts wipe
# the filesystem on every deploy, so production must use "s3".
STORAGE_DRIVER="local"
NEXT_PUBLIC_UPLOAD_BASE_URL="/uploads"

# Only needed when STORAGE_DRIVER=s3. Cloudflare R2 is recommended: no egress
# fees, which matters a lot for an image-heavy forum.
#   STORAGE_DRIVER="s3"
#   S3_BUCKET="photoforum"
#   S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"   # omit for AWS S3
#   S3_REGION="auto"                                              # "eu-west-1" etc for AWS
#   S3_ACCESS_KEY_ID=""
#   S3_SECRET_ACCESS_KEY=""
#   NEXT_PUBLIC_UPLOAD_BASE_URL="https://cdn.your-domain.com"     # public bucket/CDN origin
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------- automation ---
# The content pipeline drafts an opening post for each queued keyword and
# publishes it under a real account you control. It never creates members.
#
# Model provider. Set ONE of these; OpenRouter is checked first.
#
# OpenRouter (openrouter.ai/keys) — one key, many models. The pipeline asks for
# Claude Opus 5 through it and enables OpenRouter's web plugin, which routes to
# Anthropic's own search on Anthropic models.
OPENROUTER_API_KEY=""
# Optional. Any model id from openrouter.ai/models.
OPENROUTER_MODEL="anthropic/claude-opus-5"

# Or Anthropic direct (console.anthropic.com). Used only when OPENROUTER_API_KEY
# is unset. Budget roughly $0.10-0.30 per post either way.
ANTHROPIC_API_KEY=""

# Username of the account every generated thread is posted under. Must be a
# real member of this forum — yours.
AUTOMATION_AUTHOR_USERNAME=""

# Shared secret for /api/cron/content. Without it the endpoint refuses to run,
# because a run spends money and publishes to a live forum.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Flickr API key, for importing Creative-Commons sample photos into the gear
# database: flickr.com/services/apps/create/apply
# Only CC-BY / CC-BY-SA / CC0 photos are imported, always with attribution.
FLICKR_API_KEY=""

# --- Vercel Blob (simplest option when deployed on Vercel) -------------------
# One command sets all of this up and injects BLOB_READ_WRITE_TOKEN:
#   vercel blob create-store photoforum --access public
# Then:
#   STORAGE_DRIVER="blob"
#   NEXT_PUBLIC_UPLOAD_BASE_URL="https://<id>.public.blob.vercel-storage.com"
